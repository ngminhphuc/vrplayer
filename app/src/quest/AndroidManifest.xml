<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- For the Quest flavor, the VR XrActivity is the only launcher entry.
         Strip the LAUNCHER intent filter from the regular MainActivity so the
         Quest launcher only sees the VR app. -->
    <application>
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
